/resetwatch
*.db
*.db-journal
*.db-wal
*.db-shm
configs/config.toml
*.env

# Полные выводы команд под обёрткой cmdout (DK-264), живут только на машине.
.devkit/cmdout/

# Замок конвейера shipctl и запись его держателя, живут только на машине.
.devkit/ship.lock*

# Состояние очереди слияний shipctl, живёт только на машине.
.devkit/merge-queue.json*

# Рабочее состояние цикла цели: журнал витков, отметки доставки и замки, живут только на машине.
.devkit/goal-*

# Реплики человека живой сессии (DK-345): ждут свою сессию в дереве работы, живут только на машине.
.devkit/chat/

# Журнал итогов прогона test по компонентам (DK-1125), живёт только на машине.
.devkit/test-runs.log

# Локальная обвязка выката, живёт только на машине.
.devkit/*.local

# Журнал запусков инструментов devkit, живёт только на машине.
.devkit/log
